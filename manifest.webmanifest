{
  "name": "Pianola — MIDI para tu piano",
  "short_name": "Pianola",
  "description": "Reproduce tus archivos MIDI en un piano Roland FP-10 por Bluetooth.",
  "lang": "es",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#121110",
  "theme_color": "#121110",
  "categories": ["music", "entertainment"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "midi",
          "accept": ["audio/midi", "audio/mid", "audio/x-midi", "audio/sp-midi", "application/x-midi", ".mid", ".midi", ".kar"]
        }
      ]
    }
  },
  "file_handlers": [
    { "action": "./", "accept": { "audio/midi": [".mid", ".midi", ".kar"] } }
  ]
}
